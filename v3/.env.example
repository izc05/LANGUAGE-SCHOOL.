# demo: permite revisar las vistas privadas sin backend.
# connected: activa login y guards reales contra PocketBase.
VITE_APP_MODE=demo

# URL pública/API de PocketBase usada por el frontend.
# En desarrollo puede apuntar a localhost; en Raspberry usará HTTPS.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Clave PÚBLICA de Cloudflare Turnstile. Esta sí puede estar en VITE_*.
# En producción debe sustituirse por la site key real del dominio.
VITE_TURNSTILE_SITE_KEY=

# Variables SOLO DE SERVIDOR para PocketBase (no deben empezar por VITE_):
# TURNSTILE_SECRET_KEY=...
# TURNSTILE_EXPECTED_ACTION=contact
# TURNSTILE_ALLOWED_HOSTNAMES=academia.example.com,www.academia.example.com

# No añadir aquí credenciales de superuser, contraseñas ni tokens privados.
# Todo VITE_* termina siendo visible para el navegador.
