[Unit]
Description=Language School PocketBase
Documentation=https://pocketbase.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=languageschool
Group=languageschool
WorkingDirectory=/opt/language-school/pocketbase
EnvironmentFile=/etc/language-school/production.env
ExecStart=/opt/language-school/pocketbase/start-pocketbase.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/language-school/pb_data

[Install]
WantedBy=multi-user.target
