# Explicit deployment profile. Only pilot and production are accepted.
# production remains fail-closed; pilot is for test-only data and credentials.
DEPLOYMENT_MODE=production

# Public origin compiled into the React frontend. No trailing slash.
PUBLIC_ORIGIN=https://english.example.com
APP_NAME="Language School"

# PocketBase release pinned for Linux amd64 and ARM64 hosts.
PB_VERSION=0.39.9
PB_SHA256_AMD64=4c5a1aced62ebf658bfbcfeaa944c4bfa88b173dd9d598d3cab55ea63587b36b
PB_SHA256_ARM64=fd4138f29182288cbe6e9982e9f29b11df5f8e689c4f6a8f6cdf7aadd29d95a1

# Local service endpoints.
PB_URL=http://127.0.0.1:8091
PROXY_URL=http://127.0.0.1:8083

# Transactional email / MFA / password recovery.
# SMTP is mandatory in production because ADMIN access requires an emailed MFA code.
# A pilot may set SMTP_ENABLED=false, which disables email-dependent smoke tests.
SMTP_ENABLED=true
# Only an explicit pilot may set this true, together with loopback SMTP and no auth.
PILOT_MAIL_CAPTURE=false
SMTP_HOST=REPLACE_WITH_REAL_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_REAL_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_REAL_SMTP_PASSWORD
SMTP_AUTH_METHOD=PLAIN
SMTP_TLS=true
SMTP_LOCAL_NAME=
SMTP_SENDER_ADDRESS=REPLACE_WITH_REAL_SENDER_EMAIL
SMTP_SENDER_NAME="Language School"

# Cloudflare Turnstile. The site key is public; the secret remains server-only.
# Replace every placeholder before production deployment. A pilot may instead use
# Cloudflare's official test key pair; production rejects those keys.
TURNSTILE_SITE_KEY=REPLACE_WITH_REAL_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_REAL_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_ALLOWED_HOSTNAMES=english.example.com

# External backup disk. Backup scripts abort if this is not a real mountpoint.
BACKUP_MOUNT=/mnt/pocketbase-backup
BACKUP_RETENTION_DAYS=14

# No passwords, tunnel tokens or real credentials belong in this file in GitHub.
