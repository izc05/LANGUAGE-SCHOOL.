# Public origin compiled into the React frontend. No trailing slash.
PUBLIC_ORIGIN=https://english.example.com

# PocketBase release pinned for Raspberry Pi 4 ARM64.
PB_VERSION=0.39.9
PB_SHA256=fd4138f29182288cbe6e9982e9f29b11df5f8e689c4f6a8f6cdf7aadd29d95a1

# Local service endpoints.
PB_URL=http://127.0.0.1:8090
PROXY_URL=http://127.0.0.1:8080

# External backup disk. Backup scripts abort if this is not a real mountpoint.
BACKUP_MOUNT=/mnt/language-school-backup
BACKUP_RETENTION_DAYS=14

# No passwords, tunnel tokens or credentials belong in this file in GitHub.
